{
  "name": "tuckercowie.com",
  "private": true,
  "type": "module",
  "description": "Tucker Cowie's portfolio: one body of content, several moods.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build/build.mjs",
    "preview": "PREVIEW=1 node src/build/build.mjs",
    "serve": "node src/build/serve.mjs",
    "dev": "PREVIEW=1 node --watch-path=src --watch-path=content src/build/build.mjs --serve",
    "check:static": "node --test \"checks/static/*.test.mjs\"",
    "check:browser": "playwright test --config checks/playwright.config.mjs --trace off",
    "check": "npm run check:static && npm run check:browser"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0"
  }
}
